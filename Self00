
public class self {

    public static void main(String[] args) {
        int n = 4;
        int b = 2 * n - 1;
        for (int i = 0; i < b; i++) {
            for (int j = 0; j < b; j++) {
                if (i == j || i + j == b - 1) {
                    System.out.print("0 ");
                } else {
                    int d = Math.min(Math.min(i, j), Math.min(b - 1 - i, b - 1 - j));
                    System.out.print((n - d) + " ");
                }
            }
            System.out.println();
        }
    }
}



