public class t {

    public static void main(String[] args) {

        int[][] a = {
            {3, 4, 1},
            {8, 2, 5},
            {6, 10, 9}
        };

        int n = a.length;
        int maxRow = 0, minCol = 0;
        int maxSum = Integer.MIN_VALUE;
        int minSum = Integer.MAX_VALUE;

        for (int i = 0; i < n; i++) {

            int rowSum = 0;
            int colSum = 0;

            for (int j = 0; j < n; j++) {
                rowSum += a[i][j];
                colSum += a[j][i];
            }

            if (rowSum > maxSum) {
                maxSum = rowSum;
                maxRow = i;
            }

            if (colSum < minSum) {
                minSum = colSum;
                minCol = i;
            }
        }

        System.out.println("Max Row Index: " + maxRow);
        System.out.println("Min Column Index: " + minCol);

        if (Math.abs(maxSum - minSum) <= 5) {
            System.out.println("Balanced");
        } else {
            System.out.println("Imbalanced");
        }
    }






    Max Row Index: 2
Min Column Index: 2
Imbalanced
}
